%pip install pandasimport math
import pandas as pd

# 1. Load the monthly Changi Airport data from the team's CSV.
# Source: Civil Aviation Authority of Singapore, via data.gov.sg.
# The thousands setting reads values such as "4,420,122" as numbers.
df = pd.read_csv("AirTrafficMovements.csv", thousands=",")
print("Original dataset shape (rows, columns):", df.shape)

# 2. Convert the Month column to dates and sort from oldest to newest.
df["Month"] = pd.to_datetime(df["Month"], format="%Y-%m", errors="raise")
df = df.sort_values("Month").reset_index(drop=True)

# 3. Check that the study contains one record for every expected month.
expected_months = pd.date_range(start="2015-01-01", end="2026-07-01", freq="MS")
actual_months = pd.DatetimeIndex(df["Month"])

missing_months = expected_months.difference(actual_months)
unexpected_months = actual_months.difference(expected_months)

print("\nData quality checks")
print("Missing values:", df.isna().sum().sum())
print("Duplicate months:", df["Month"].duplicated().sum())
print("Missing months:", missing_months.strftime("%Y-%m").tolist())
print("Months outside the study period:", unexpected_months.strftime("%Y-%m").tolist())
print("Rows where Year disagrees with Month:", (df["Year"] != df["Month"].dt.year).sum())

# 4. Check whether each reported total equals the sum of its components.
# Difference = reported total minus the sum of its components.
differences = pd.DataFrame({
    "Aircraft": df["Aircraft_Total"] - (
        df["Aircraft_Arrival"] + df["Aircraft_Departure"]
    ),
    "Passengers": df["Passenger_Total"] - (
        df["Passenger_Arrival"] + df["Passenger_Departures"] + df["Passenger_Transit"]
    ),
    "AirMail": df["AirMail_Total"] - (
        df["AirMail_Incoming"] + df["AirMail_Outgoing"]
    ),
    "Cargo": df["Cargo_Total"] - (
        df["Cargo_Total_Import"] + df["Cargo_Total_Export"]
    )
}).round(4)

print("\nLargest absolute difference in each category:")
print(differences.abs().max().to_string())

# Display cargo differences larger than 0.01 and retain the published values.
cargo_check = pd.DataFrame({
    "Month": df["Month"].dt.strftime("%Y-%m"),
    "Cargo_difference": differences["Cargo"]
})
print("\nMonths with a cargo difference larger than 0.01:")
print(cargo_check.loc[cargo_check["Cargo_difference"].abs() > 0.01].to_string(index=False))

# 5. Prepare the calendar columns used in the proposal and the team's charts.
# month_dummy is the existing team name for the calendar month (1 to 12).
df["month_dummy"] = df["Month"].dt.month

# These two columns let the model treat December and January as neighbours.
month_angle = 2 * math.pi * df["month_dummy"] / 12
df["month_sin"] = month_angle.map(math.sin)
df["month_cos"] = month_angle.map(math.cos)

# Use the proposal's definitions for the COVID period and school holiday months.
df["iscovid"] = df["Year"].between(2020, 2022).astype(int)
df["IsHoliday"] = df["month_dummy"].isin([6, 12]).astype(int)

# Preview five rows of the cleaned table.
print("\nCleaned data preview:")
df[["Month", "Passenger_Total", "Aircraft_Total", "month_dummy", "iscovid", "IsHoliday"]].head()
